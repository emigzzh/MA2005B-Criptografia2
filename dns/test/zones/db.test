$TTL 86400
@   IN  SOA ns.test. admin.test. (
        2026102104 ; Serial
        3600       ; Refresh
        1800       ; Retry
        604800     ; Expire
        86400 )    ; Minimum TTL

@   IN  NS  ns.test.
ns  IN  A   172.30.0.30

; Subdominios de prueba (con errores de DNSSEC)

badalg.test.    IN NS  ns.badalg.test.
ns.badalg.test. IN A   172.30.0.31

expired.test.   IN NS  ns.expired.test.
ns.expired.test. IN A  172.30.0.32

nods.test.      IN NS  ns.nods.test.
ns.nods.test.   IN A   172.30.0.33

walkable.test.  IN NS  ns.walkable.test.
ns.walkable.test. IN A 172.30.0.34

$INCLUDE dsset-walkable.test.
$INCLUDE dsset-badalg.test.

$INCLUDE dsset-expired.test.
